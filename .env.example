# GitHub OAuth app — create one at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string used by Auth.js to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to true for local dev. Vercel handles this automatically in prod.
AUTH_TRUST_HOST=true

# Only this GitHub username can sign in and view private content.
OWNER_USERNAME=jing0728
