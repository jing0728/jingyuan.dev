---
import Base from '../layouts/Base.astro';
import { getVisibleEntries } from '../lib/content';

const [learning, projects, experience, leetcode] = await Promise.all([
  getVisibleEntries('learning', Astro.request),
  getVisibleEntries('projects', Astro.request),
  getVisibleEntries('experience', Astro.request),
  getVisibleEntries('leetcode', Astro.request),
]);

const regions = [
  { href: '/about',      icon: '🏠', label: 'About me',   desc: 'Walk into my house',     count: null as number | null },
  { href: '/experience', icon: '🌾', label: 'Experience', desc: 'Fields I have farmed',   count: experience.length },
  { href: '/learning',   icon: '📚', label: 'Learning',   desc: 'Books and notes',        count: learning.length },
  { href: '/projects',   icon: '🔨', label: 'Projects',   desc: 'The workshop',           count: projects.length },
  { href: '/leetcode',   icon: '⛰️', label: 'LeetCode',   desc: 'Into the mines',         count: leetcode.length },
];
---
<Base title="Quick list · jingyuan.dev">
  <section class="hero">
    <h1>Quick list</h1>
    <p class="tagline">No time to explore the map? Pick a region below.</p>
    <p><a href="/" class="back">← Back to the farm</a></p>
  </section>

  <section class="regions">
    {regions.map((r) => (
      <a href={r.href} class="region">
        <div class="icon">{r.icon}</div>
        <div class="body">
          <h2>{r.label}</h2>
          <p>{r.desc}</p>
        </div>
        {r.count !== null && <div class="count">{r.count}</div>}
      </a>
    ))}
  </section>
</Base>

<style>
  .hero { text-align: center; margin: 1rem 0 2rem; }
  .hero h1 { font-size: 2.25rem; color: var(--accent); margin: 0 0 0.5rem; }
  .tagline { color: var(--muted); font-size: 1.1rem; margin: 0 0 0.75rem; }
  .back { font-weight: 600; }
  .regions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .region {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 3px solid var(--border);
    outline: 3px solid var(--border-dark);
    box-shadow: 6px 6px 0 var(--shadow);
    color: var(--fg);
    text-decoration: none;
    border-bottom: 3px solid var(--border);
    transition: transform 0.06s, box-shadow 0.06s;
  }
  .region:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow);
    color: var(--fg);
    border-bottom-color: var(--border);
  }
  .region:active {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 var(--shadow);
  }
  .icon { font-size: 2.5rem; line-height: 1; flex-shrink: 0; }
  .body { flex: 1; min-width: 0; }
  .body h2 { margin: 0 0 0.25rem; font-size: 1.4rem; color: var(--accent); }
  .body p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .count {
    background: var(--accent-2);
    color: var(--card-bg);
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--border-dark);
    font-weight: 700;
    min-width: 2.2rem;
    text-align: center;
    font-size: 1rem;
  }
</style>
