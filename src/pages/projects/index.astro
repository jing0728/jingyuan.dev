---
import Base from '../../layouts/Base.astro';
import { getVisibleEntries } from '../../lib/content';

const projects = await getVisibleEntries('projects', Astro.request);
---
<Base title="Projects · jingyuan.dev" description="GitHub projects I've built.">
  <header class="page-head">
    <h1>🔨 Projects</h1>
    <p>Things I've built — with the why behind them.</p>
  </header>

  {projects.length === 0 ? (
    <div class="frame empty">No projects yet. Add one in <code>src/content/projects/</code>.</div>
  ) : (
    <ul class="list">
      {projects.map((p) => (
        <li class="frame">
          <div class="title-row">
            <a href={`/projects/${p.id}`} class="title">{p.data.title}</a>
            {p.data.private && <span class="badge-private">private</span>}
          </div>
          <div class="meta">
            {p.data.tech.map((t) => <span class="tag">{t}</span>)}
          </div>
          {p.data.summary && <p class="summary">{p.data.summary}</p>}
          <div class="row-links">
            {p.data.repo && <a href={p.data.repo} class="pixel-btn small">GitHub ↗</a>}
            {p.data.demo && <a href={p.data.demo} class="pixel-btn small alt">Demo ↗</a>}
          </div>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .page-head { margin-bottom: 1.5rem; }
  .page-head p { color: var(--muted); margin: 0; }
  .list { list-style: none; padding: 0; }
  .list .frame { margin-bottom: 1.25rem; }
  .title-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 3px solid transparent;
  }
  .title:hover { border-bottom-color: var(--accent); }
  .meta { margin: 0.5rem 0; }
  .summary { color: var(--muted); margin: 0.5rem 0; }
  .row-links { margin-top: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pixel-btn.small { font-size: 0.9rem; padding: 0.3rem 0.7rem; }
  .pixel-btn.alt { background: var(--accent-2); }
  .empty { text-align: center; color: var(--muted); }
</style>
